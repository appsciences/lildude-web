rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function validEmail(e) { return e is string && e.size() < 255 && e.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }

    // Public can add themselves, never read or modify.
    match /waitlist/{id} {
      allow create: if validEmail(request.resource.data.email)
        && request.resource.data.keys().hasOnly(['email', 'name', 'source', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
