# Firebase web config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=lildude-web.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lildude-web
VITE_FIREBASE_STORAGE_BUCKET=lildude-web.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Media served from Firebase Storage / CDN (leave blank to use /media/* on Hosting)
VITE_MEDIA_BASE=

# Stripe Payment Links (create in Stripe dashboard, no backend needed)
VITE_STRIPE_DONATE_URL=
VITE_STRIPE_PREORDER_URL=
