# Firebase web config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=backup-2b746.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=backup-2b746
VITE_FIREBASE_STORAGE_BUCKET=backup-2b746.firebasestorage.app
VITE_FIREBASE_APP_ID=

# Media served from Firebase Storage / CDN (leave blank to use /media/* on Hosting)
VITE_MEDIA_BASE=

# PayPal (no backend needed)
# Your PayPal.me link, used for preset donation amounts and pre-order totals
VITE_PAYPAL_ME=https://paypal.me/yourname
# PayPal checkout button link for pre-orders (colour/quantity options are set on the button)
VITE_PAYPAL_CHECKOUT_URL=
# Optional: hosted PayPal Donate button link for "any amount"
VITE_PAYPAL_DONATE_URL=

# Google Analytics 4 measurement ID (G-XXXXXXX). Blank = analytics off.
VITE_GA_MEASUREMENT_ID=
